rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.keys().hasOnly(['name', 'email']);
      allow delete: if isAdmin();
    }

    match /hostellerProfiles/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'block',
          'roomNumber',
          'enrollmentNumber',
          'verificationStatus'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'block',
          'roomNumber',
          'enrollmentNumber',
          'verificationStatus'
        ])
        && request.resource.data.verificationStatus == 'pending';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus'])
        && request.resource.data.verificationStatus in ['approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /mealBookings/{bookingId} {
      function isOwnBookingId(documentId) {
        return isSignedIn()
          && documentId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_(Breakfast|Lunch|Dinner)$');
      }

      function hasApprovedProfile() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/hostellerProfiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/hostellerProfiles/$(request.auth.uid)).data.verificationStatus == 'approved';
      }

      function hasValidBookingShape() {
        return request.resource.data.keys().hasAll(['userId', 'date', 'mealType', 'status'])
          && request.resource.data.keys().hasOnly(['userId', 'date', 'mealType', 'status'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.mealType in ['Breakfast', 'Lunch', 'Dinner']
          && request.resource.data.status in ['booked', 'cancelled']
          && bookingId == request.resource.data.userId + '_' + request.resource.data.date + '_' + request.resource.data.mealType;
      }

      allow get: if isOwnBookingId(bookingId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if hasApprovedProfile()
        && hasValidBookingShape()
        && request.resource.data.status == 'booked';

      allow update: if hasApprovedProfile()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['booked', 'cancelled']
        && bookingId == resource.data.userId + '_' + resource.data.date + '_' + resource.data.mealType;

      allow delete: if false;
    }
  }
}